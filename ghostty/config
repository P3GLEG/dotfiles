# Ghostty config — terminal layer for cmux.
#
# cmux embeds Ghostty, so anything Ghostty already does (font, theme,
# padding, scrollback, shell integration) belongs HERE, not in cmux.json.
# `cmux reload-config` reloads BOTH this file and ~/.config/cmux/cmux.json.
#
# Installed by install.sh as a symlink of this FILE to
# ~/.config/ghostty/config -- not the directory. Ghostty creates that
# directory on first run, and linking a directory onto an existing real
# directory nests the link inside it instead of replacing it.

# ── Font ──────────────────────────────
font-family = Anonymous Pro
font-size = 16
font-thicken = true
font-thicken-strength = 50
adjust-cell-height = 2
adjust-underline-position = 4
grapheme-width-method = unicode

# cmux draws the sidebar itself; this sizes it independently of the terminal.
sidebar-font-size = 10.5

# ── Colors: custom deep purple ────────
# Explicit colours, NOT a `theme = ` name. This is the look actually in use;
# it had been living outside git in
#   ~/Library/Application Support/com.mitchellh.ghostty/config.ghostty
# which is why a fresh machine looked duller. Explicit background/palette
# keys beat a `theme` name, so this wins wherever it is loaded from.
#
# For reference, the named themes this replaces: Urple is #1b1b23 on
# #877a9b -- a muted grey-purple. This is #15152b on pure #ffffff, which is
# the crisper contrast worth keeping.
background = #15152b
foreground = #ffffff
selection-background = #380d6a
selection-foreground = #ffffff
cursor-color = #ffffff
cursor-text = #15152b
minimum-contrast = 1.1
palette = 0=#000000
palette = 1=#e33937
palette = 2=#3ad900
palette = 3=#fad000
palette = 4=#7857fe
palette = 5=#ff2c70
palette = 6=#80fcff
palette = 7=#ffffff
palette = 8=#5c5c61
palette = 9=#e33937
palette = 10=#3ad900
palette = 11=#fad000
palette = 12=#6943ff
palette = 13=#fb94ff
palette = 14=#80fcff
palette = 15=#ffffff

# ── macOS ─────────────────────────────
macos-option-as-alt = true
macos-non-native-fullscreen = true
macos-titlebar-proxy-icon = hidden
window-colorspace = display-p3
# macos-titlebar-style is deliberately unset: cmux owns the window chrome
# and draws its own sidebar/tab UI. Forcing "tabs" fights it.

# ── Window & appearance ───────────────
window-padding-x = 8
window-padding-y = 4
window-padding-balance = true
window-padding-color = extend
window-save-state = always
confirm-close-surface = false
resize-overlay = never
unfocused-split-opacity = 0.7
focus-follows-mouse = true

# ── Cursor ────────────────────────────
cursor-style = block
cursor-style-blink = false

# ── Mouse ─────────────────────────────
mouse-hide-while-typing = true
mouse-scroll-multiplier = 3

# ── Clipboard & selection ─────────────
# copy-on-select stays false to match terminal.copyOnSelect in cmux.json.
copy-on-select = false
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true
clipboard-paste-bracketed-safe = true

# ── Shell integration ─────────────────
# cmux relies on shell integration for cwd tracking, which is what feeds
# sidebar.showBranchDirectory and the repo badge.
shell-integration = detect
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo

# ── Scrollback ────────────────────────
# Agents emit a lot. This is per-surface, so it interacts with cmux's
# rendererRealization/agentHibernation memory management -- if RAM gets
# tight with many panes, this is the first number to lower.
scrollback-limit = 10000000

# ── Working directory ─────────────────
working-directory = ~/workspace

# ── Quick terminal (hotkey window) ────
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.2
quick-terminal-autohide = true

# ── Notifications ─────────────────────
# notify-on-command-finish is deliberately NOT set. The old standalone
# config had `notify-on-command-finish = unfocused` / `after = 10s`, but
# cmux already raises turn-complete notifications through its Claude
# wrapper (notifications.agentTurnComplete in cmux.json) and fans out via
# notifications.command. Letting Ghostty notify too means every finished
# agent turn alerts twice.

# auto-update is not set either: cmux ships and updates its own embedded
# Ghostty, so a standalone updater has nothing to do here.

# ── Keybinds ──────────────────────────
# Only bindings that cannot collide with a cmux command.
keybind = unconsumed:shift+page_up=scroll_page_up
keybind = unconsumed:shift+page_down=scroll_page_down
keybind = performable:ctrl+c=copy_to_clipboard

# cmd+shift+comma=reload_config is NOT bound: that is cmux's own
# reloadConfiguration default, and cmux reloads BOTH configs anyway.
#
# Nothing else belongs here. This file used to carry a tmux passthrough
# block sending Ctrl-B prefix sequences for cmd+1..9, cmd+d, cmd+shift+d,
# cmd+w, cmd+t and cmd+shift+enter. Under cmux each of those shadows a real
# command -- selectWorkspaceByNumber, splitRight, splitDown, close, new tab,
# toggleSplitZoom -- and Ghostty would swallow the key and emit a raw escape
# sequence into the terminal instead, so workspace switching simply stopped
# working. Add keybindings in cmux.json under "shortcuts.bindings".
