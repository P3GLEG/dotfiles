# Ghostty config — terminal layer for cmux.
#
# cmux embeds Ghostty, so anything Ghostty already does (font, theme,
# padding, scrollback, shell integration) belongs HERE, not in cmux.json.
# `cmux reload-config` reloads BOTH this file and ~/.config/cmux/cmux.json.
#
# Installed by install.sh as a symlink of this FILE to
# ~/.config/ghostty/config -- not the directory. Ghostty creates that
# directory on first run, and linking a directory onto an existing real
# directory nests the link inside it instead of replacing it.

# ── Font ──────────────────────────────
font-family = Iosevka Nerd Font
font-size = 14
adjust-cell-height = 2
adjust-underline-position = 4
grapheme-width-method = unicode

# ── Colors ────────────────────────────
theme = Catppuccin Mocha
minimum-contrast = 1.1
split-divider-color = #45475a

# ── macOS ─────────────────────────────
macos-option-as-alt = true
macos-non-native-fullscreen = true
macos-titlebar-proxy-icon = hidden
window-colorspace = display-p3
# macos-titlebar-style is deliberately unset: cmux owns the window chrome
# and draws its own sidebar/tab UI. Forcing "tabs" fights it.

# ── Window & appearance ───────────────
window-padding-x = 8
window-padding-y = 4
window-padding-balance = true
window-padding-color = extend
window-save-state = always
confirm-close-surface = false
resize-overlay = never
unfocused-split-opacity = 0.7
focus-follows-mouse = true

# ── Cursor ────────────────────────────
cursor-style = block
cursor-style-blink = false

# ── Mouse ─────────────────────────────
mouse-hide-while-typing = true
mouse-scroll-multiplier = 3

# ── Clipboard & selection ─────────────
# copy-on-select stays false to match terminal.copyOnSelect in cmux.json.
copy-on-select = false
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true
clipboard-paste-bracketed-safe = true

# ── Shell integration ─────────────────
# cmux relies on shell integration for cwd tracking, which is what feeds
# sidebar.showBranchDirectory and the repo badge.
shell-integration = detect
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo

# ── Scrollback ────────────────────────
# Agents emit a lot. This is per-surface, so it interacts with cmux's
# rendererRealization/agentHibernation memory management -- if RAM gets
# tight with many panes, this is the first number to lower.
scrollback-limit = 10000000

# ── Working directory ─────────────────
working-directory = ~/workspace

# ── Quick terminal (hotkey window) ────
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.2
quick-terminal-autohide = true

# ── Keybinds ──────────────────────────
# NOTHING here, deliberately.
#
# This file used to carry a tmux passthrough block that sent Ctrl-B prefix
# sequences: cmd+1..9, cmd+d, cmd+shift+d, cmd+w, cmd+t, cmd+shift+enter.
# Under cmux every one of those collides with a cmux command --
# selectWorkspaceByNumber, splitRight, splitDown, close, new tab,
# toggleSplitZoom -- and Ghostty would swallow the key and emit a raw
# escape sequence into the terminal instead. Workspace switching in
# particular would simply stop working.
#
# Keybindings live in cmux.json under "shortcuts.bindings". Add them there.
