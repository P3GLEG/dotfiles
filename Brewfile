# cmux agent hooks parse JSON payloads with jq and shell out to fzf for the
# task picker. Recent macOS ships /usr/bin/jq, but do not rely on it: without
# jq the sidebar hooks degrade silently (no task label) and the stall
# watchdog exits outright. fzf is optional -- new-task.sh falls back to a
# numbered menu -- but the picker is far nicer with it.
brew "jq"
brew "fzf"

brew "eza"
brew "starship"
brew "neovim"
brew "node"
brew "python"
brew "ripgrep"
brew "tmux"
brew "tree-sitter-cli"
brew "wget"
cask "font-iosevka-nerd-font"
